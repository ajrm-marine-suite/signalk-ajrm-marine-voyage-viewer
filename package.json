{
  "name": "signalk-ajrm-marine-voyage-viewer",
  "version": "0.7.1",
  "description": "Plots and exports AJRM Marine Capture voyage tracks.",
  "main": "plugin/index.js",
  "scripts": {
    "test": "node --test && node --check plugin/index.js && node --check public/app.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-navigation",
    "voyage",
    "track",
    "charts",
    "signal-k",
    "signalk",
    "ajrm-marine-suite",
    "marine",
    "navigation"
  ],
  "author": "Anthony McDonald, with assistance from William McAusland",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajrm-marine-suite/signalk-ajrm-marine-voyage-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/ajrm-marine-suite/signalk-ajrm-marine-voyage-viewer/issues"
  },
  "homepage": "https://github.com/ajrm-marine-suite/signalk-ajrm-marine-voyage-viewer#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "plugin",
    "public",
    "README.md",
    "LICENSE"
  ],
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "displayName": "AJRM Marine Voyage Viewer",
    "appIcon": "./public/icon.svg",
    "recommends": [
      "signalk-ajrm-marine-capture"
    ]
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@ajrm-marine/map-core": "github:ajrm-marine-suite/ajrm-marine-map-core#v0.7.0",
    "adm-zip": "^0.6.0"
  }
}
